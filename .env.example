# Base URL of the Swasth Infinity backend. The app appends /api/auth and
# /api/admin to this value. Production deployments point at the hosted backend.
NEXT_PUBLIC_API_BASE_URL=https://sih24-backend.onrender.com

# Condition-based yoga pose suggestions (src/components/yogahealth/yoga.js).
# The underlying condition-to-pose mapping is not clinically reviewed and its
# results carry no source or review metadata, so this is off by default.
# Set to "true" only for a demo, where the in-app disclaimer is also shown.
NEXT_PUBLIC_ENABLE_CONDITION_SUGGESTIONS=false
